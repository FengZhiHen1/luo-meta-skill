{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:luo-meta-skill:evals",
  "title": "Eval case file",
  "description": "Authoritative shape of a skill's test set. scripts/check_evals.py validates case files against this file.",
  "type": "object",
  "required": [
    "evals"
  ],
  "properties": {
    "skill_name": {
      "type": "string",
      "minLength": 1
    },
    "evals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "additionalProperties": true,
  "$defs": {
    "case": {
      "type": "object",
      "required": [
        "prompt"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "expected_output": {
          "type": "string",
          "minLength": 1
        },
        "files": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "assertions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "expectations": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "kind": {
          "type": "string",
          "enum": [
            "task",
            "trigger",
            "contract",
            "pressure",
            "routing"
          ]
        },
        "expect_trigger": {
          "type": "boolean"
        },
        "holdout": {
          "type": "boolean"
        },
        "weight": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": true
    }
  }
}
